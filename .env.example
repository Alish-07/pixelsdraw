# Supabase project settings → API. Use only the PUBLIC publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Set true only after configuring and testing a production email provider.
NEXT_PUBLIC_EMAIL_SIGN_IN_ENABLED=false

# Enable only after configuring Supabase Passkeys for this exact relying party.
NEXT_PUBLIC_PASSKEYS_ENABLED=false
NEXT_PUBLIC_PASSKEY_RP_ID=

# Optional: set the purchased domain here and in Vercel before rebuilding.
# Leave indexing off throughout the beta; enable deliberately after launch checks.
NEXT_PUBLIC_SITE_URL=https://pixel-art-studio-alpha-one.vercel.app
NEXT_PUBLIC_ALLOW_INDEXING=false
